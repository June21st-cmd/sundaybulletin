# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/
python-embed/

# Output files
output/*
!output/.gitkeep
tmp/*
!tmp/.gitkeep
scratch/

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Environment & Credentials
.env
.env.local
*.pem
*.key

# Typst output caches if any
*.pdf.tmp

# Build & packaging
*.egg-info/
build/
dist/

# Local input data & PII protection (Security Rule 2)
data/inputs/*
!data/inputs/.gitkeep
input/*
!input/.gitkeep
